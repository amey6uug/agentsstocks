# Copy to .env and fill in what you need. Every key here is optional --
# with an empty .env the app runs offline on the deterministic engine.

# --- Telegram (leave blank to skip the messaging step) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM debate engine ---
# Leave LLM_PROVIDER blank to auto-detect: claude CLI -> ANTHROPIC_API_KEY
# -> OPENAI_API_KEY -> deterministic.
# Force one with: claude_code | anthropic | openai | deterministic
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The claude CLI is found on PATH, or inside the VS Code extension. Set this
# only if yours lives somewhere else entirely.
CLAUDE_CLI_PATH=

# --- App ---
BRAND=AgentDesk
CONFIDENCE_THRESHOLD=7
AGENT_DELAY=0.6
# Stocks debated per run (the Stocks dropdown overrides this)
STOCK_COUNT=8
PORT=5000

# Set this before exposing the app on a public URL -- it turns on HTTP Basic
# auth for every route. Leave blank for local use.
APP_PASSWORD=
